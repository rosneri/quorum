generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  name      String
  // Optional Supabase Auth link — lets the same person sign back in on
  // another device. Anonymous (cookie-only) users have both fields null.
  email     String?  @unique
  authId    String?  @unique
  createdAt DateTime @default(now())

  memberships    Membership[]
  events         Event[]
  rsvps          Rsvp[]
  pollVotes      PollVote[]
  availabilities Availability[]
}

model Group {
  id          String   @id @default(cuid())
  name        String
  adminId     String?
  inviteToken String   @unique @default(cuid())
  createdAt   DateTime @default(now())

  memberships Membership[]
  events      Event[]
}

model Membership {
  userId   String
  groupId  String
  joinedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
}

enum EventStatus {
  PROPOSED
  CONFIRMED
  CANCELLED
  DONE
}

model Event {
  id          String      @id @default(cuid())
  groupId     String?
  creatorId   String
  title       String
  emoji       String?
  startsAt    DateTime?
  flexMinutes Int?
  status      EventStatus @default(PROPOSED)
  inviteToken String      @unique @default(cuid())
  isPoll      Boolean     @default(false)
  publicVotes Boolean     @default(true)
  createdAt   DateTime    @default(now())
  editedAt    DateTime?

  group       Group?       @relation(fields: [groupId], references: [id], onDelete: SetNull)
  creator     User         @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  rsvps          Rsvp[]
  pollOptions    PollOption[]
  availabilities Availability[]
}

enum RsvpState {
  IN
  MAYBE
  OUT
}

model Rsvp {
  eventId     String
  userId      String
  state       RsvpState
  personalMin Int       @default(0)
  updatedAt   DateTime  @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
}

// A person's stated availability for a poll event: a window (from–until)
// or a specific moment (until = null).
model Availability {
  id      String    @id @default(cuid())
  eventId String
  userId  String
  from    DateTime
  until   DateTime?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model PollOption {
  id       String   @id @default(cuid())
  eventId  String
  startsAt DateTime
  // A time a participant proposed that the owner hasn't folded into the plan
  // yet — shown with a "?" until the owner confirms it (via editing).
  suggested Boolean @default(false)

  event Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  votes PollVote[]
}

model PollVote {
  optionId String
  userId   String

  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([optionId, userId])
}
